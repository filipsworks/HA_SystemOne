HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# TypeSafe AI key (https://typesafe.ai)
TYPESAFE_API_KEY=your-typesafe-api-key
# Optional: pin a model, e.g. jev-1.13.0 (default: the API's latest)
# TYPESAFE_MODEL=jev-1.13.0
# Optional: confidence threshold (default 0.8)
# DECISION_MIN_CONFIDENCE=0.8
# Bearer token for `decide serve` (required for execute over HTTP), e.g. `openssl rand -hex 32`
# DECISION_API_TOKEN=change-me
